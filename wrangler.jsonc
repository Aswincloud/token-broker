{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "token-broker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-01",
  "account_id": "e38978124c8fdb38dc80c04cda318ab3",
  "workers_dev": false,
  "observability": { "enabled": true },
  "routes": [{ "pattern": "token-broker.aswincloud.com", "custom_domain": true }],
  "vars": {
    "APP_ID": "1597322",
    "APP_INSTALLATION_ID": "119111837",
    "AUDIENCE": "https://token-broker.aswincloud.com"
  }
  // APP_PRIVATE_KEY is a Worker secret (wrangler secret put), never configured here.
}
